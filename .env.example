# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every variable here is server-only. Do NOT add a NEXT_PUBLIC_ prefix to any
# of them, or the value will be inlined into the browser bundle.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string.
#   Local:   postgresql://USER:PASSWORD@localhost:5432/DATABASE
#   Supabase:postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Percent-encode reserved characters in the password (@ -> %40, : -> %3A, / -> %2F).
#
# Note: db.PROJECT_REF.supabase.co is IPv6-only in several regions. On an
# IPv4-only network use the session pooler instead, port 6543:
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:2060@localhost:5432/employee_Corevia

# Optional. Max connections in the server-side pool. Default 10.
# DATABASE_POOL_MAX=10

# Optional. Force TLS even when the URL does not carry sslmode=require.
# Supabase requires this. Default false.
# DATABASE_SSL=false
